-# Common suffixes used in GGUF file naming conventions
-# e.g., Q4_K_M, Q3_K_S, Q5_K_L, Q2_K_XL
-_GGUF_QUANT_SUFFIXES = ("_M", "_S", "_L", "_XL", "_XS", "_XXS")
