+    torch.testing.assert_close(out_split, out_full, atol=1e-2, rtol=1e-2)
+
+
+@pytest.mark.skipif(
+    not torch.cpu._is_amx_tile_supported(),
+    reason="causal_conv1d_fwd_cpu requires AMX/AVX512",
