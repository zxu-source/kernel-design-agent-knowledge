+            max_seqlen_k=max_dcp_context_kv_len,
+            softmax_scale=softmax_scale,
+            causal=False,
+            alibi_slopes=alibi_slopes,
+            window_size=sliding_window_size,
+            block_table=block_table[prefill_req_slice],
