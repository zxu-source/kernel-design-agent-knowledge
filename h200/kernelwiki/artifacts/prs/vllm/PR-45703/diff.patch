+def _moe_pad_last(x: torch.Tensor, n: int, padded_n: int) -> torch.Tensor:
+    """Zero-pad the last dim of a ``(E, ..., n)`` tensor to padded_n."""
+    if padded_n == n:
+        return x
+    return torch.nn.functional.pad(x, (0, padded_n - n))
