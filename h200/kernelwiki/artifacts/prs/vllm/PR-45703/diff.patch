+    rest = x.shape[2:]
+    x = x.view(e, 2, n, *rest)
+    x = torch.nn.functional.pad(x, (0, 0) * len(rest) + (0, padded_n - n))
+    return x.reshape(e, 2 * padded_n, *rest)
+
