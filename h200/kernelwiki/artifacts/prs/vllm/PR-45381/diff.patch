+def build_order_call() -> str:
+    return (
+        f"{NS}<tool_call>\n"
+        f'{NS}<invoke name="create_order">'
+        f"{NS}<user_id>42{NS}</user_id>"
+        f"{NS}<urgent>true{NS}</urgent>"
+        f"{NS}<note>Please leave at front desk.{NS}</note>"
+        f"{NS}<shipping>"
