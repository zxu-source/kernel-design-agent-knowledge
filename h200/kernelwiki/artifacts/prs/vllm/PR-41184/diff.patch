+
+    @property
+    def eplb_state(self) -> EplbLayerState | None:
+        return self.router.eplb_state
+
+    def set_eplb_state(
+        self,
+        moe_layer_idx: int,
+        expert_load_view: torch.Tensor,
+        logical_to_physical_map: torch.Tensor,
+        logical_replica_count: torch.Tensor,
