+        BLOCK_N,
+        False,  # HAS_PREFILL
+        count_valid,
+        compact_valid_to_front,
+        dcp_size,
+        dcp_rank,
+        cp_kv_cache_interleave_size,
+        bt_stride0,
+        bt_stride1,
+        ti_stride0,
+        ti_stride1,
+        out_stride0,
+        out_stride1,
