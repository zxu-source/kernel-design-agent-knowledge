+class MiniMaxM3VLProcessor(BaseMultimodalProcessor):
+    models = [
+        MiniMaxM3SparseForConditionalGeneration,
+    ]
+
+    gpu_image_decode = False
+
+    # M3's tokenizer has no pad_token.
+    tokenizer_padding = False
+
+    IMAGE_TOKEN = "]<]image[>["
+    VIDEO_TOKEN = "]<]video[>["
