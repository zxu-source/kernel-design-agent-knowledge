+            ),
+            "special": (
+                "<tool_call>",
+                '<invoke name="add_note">',
+                "<note>" + 'a "q" and \\ back\nslash',
+                "</note>",
+                "</invoke>",
+                "</tool_call>",
+            ),
+            "multi_invoke": (
+                "<tool_call>",
+                '<invoke name="get_weather">',
