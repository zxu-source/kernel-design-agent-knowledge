+                    "type": "object",
+                    "properties": {"note": {"type": "string"}},
+                },
+            ),
+        ),
+        Tool(
+            type="function",
+            function=Function(
+                name="configure",
+                description="Configure runtime options",
+                parameters={
+                    "type": "object",
+                    "properties": {
+                        "mode": {
+                            "type": "string",
+                            "enum": ["none", "low", "high"],
+                        },
+                        "optional": {"type": ["string", "null"]},
+                    },
+                },
