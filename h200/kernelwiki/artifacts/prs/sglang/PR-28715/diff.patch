+            ),
+            video_token=self.VIDEO_TOKEN,
+            video_token_id=self.VIDEO_TOKEN_ID,
+            video_token_regex=re.compile(r"<video>|<\|video\|>|\]\<\]video\[\>\["),
+        ).build(_processor)
+
+    async def process_mm_data_async(
+        self,
+        image_data: Optional[List],
+        audio_data: Optional[List],
