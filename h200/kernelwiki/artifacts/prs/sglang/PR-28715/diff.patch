+    for layer_idx, qkv_dict in vit_qkv_weights.items():
+        if {"q", "k", "v"} <= qkv_dict.keys():
+            merged = torch.cat([qkv_dict["q"], qkv_dict["k"], qkv_dict["v"]], dim=0)
