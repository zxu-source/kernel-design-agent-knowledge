@@ -39,6 +39,10 @@ def __init__(
 
         if runner_backend.is_triton():
             self.runner_core = TritonRunnerCore(config)
+        elif runner_backend.is_ascend():
+            from sglang.srt.layers.moe.moe_runner.ascend import AscendRunnerCore
+
