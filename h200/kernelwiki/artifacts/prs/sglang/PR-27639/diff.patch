+                next_latents = scheduler.step(
+                    flow_pred,
+                    timestep,
+                    current_latents,
+                    return_dict=False,
+                )[0]
+
+                current_latents = next_latents
+                if clamp_latent is not None:
+                    current_latents[:, :, :context_frames] = clamp_latent
+
+                if progress_bar is not None:
+                    progress_bar.update()
