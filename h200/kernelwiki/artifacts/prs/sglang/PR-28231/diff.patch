-# ── Per-slot GEMV kernel: processes one (token, expert) pair ──
-
-
-@triton.autotune(
-    configs=[
-        triton.Config({"BLOCK_N": 64, "BLOCK_K": 64}, num_warps=4, num_stages=2),
-        triton.Config({"BLOCK_N": 32, "BLOCK_K": 64}, num_warps=4, num_stages=2),
