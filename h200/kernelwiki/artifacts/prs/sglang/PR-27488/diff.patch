+            qg,
+            qg2,
+            kg,
+            v_new,
+            h_flat,
+            o,
+            cu_seqlens,
+            chunk_indices,
+            total_chunks,
+            Int32(148),
+            stream,
+            options="--enable-tvm-ffi",
+        )
+
+
+def kda_o_cutedsl(
+    qg: torch.Tensor,
+    qg2: torch.Tensor,
+    kg: torch.Tensor,
+    v_new_chunks: torch.Tensor,
+    h: torch.Tensor,
+    o: torch.Tensor,
+    cu_seqlens: torch.Tensor,
+    chunk_indices: torch.Tensor,
+    total_chunks: torch.Tensor,
+    num_sms: int = 148,
+) -> None:
+    """KDA output kernel. qg/qg2/kg are the pre-scaled tensors (see module doc)."""
+    _, Hv, K_dim = qg.shape
+    _, _, V_dim = o.shape
+    Sm100KdaChunkOKernel.compile(Hv, Hv, K_dim, V_dim)(
+        qg,
+        qg2,
+        kg,
+        v_new_chunks.view(-1, Hv, V_dim),
+        h.view(-1, V_dim, K_dim),
+        o,
+        cu_seqlens,
+        chunk_indices,
+        total_chunks,
+        num_sms,
+    )
