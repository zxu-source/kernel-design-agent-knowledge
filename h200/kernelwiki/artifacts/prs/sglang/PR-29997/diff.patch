-  ////////////////////// top 1 //////////////////////
-#pragma unroll
-  for (int v = 1; v < Vlen; v++) {
-    // per-thread max
-    if (bias_chunk[v] > max_val) {
-      max_val = bias_chunk[v];
-      max_idx = exp_idx_in_grp + v;
-    }
-  }
-#pragma unroll
-  for (int mask = NR_THREADS_PER_GRP / 2; mask > 0; mask /= 2) {
