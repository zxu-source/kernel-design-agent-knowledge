-          } else if (input.scalar_type() == at::kHalf) {
-            LAUNCH_MOE_GATE_CONFIG(float16_t, 256, 16);
-          } else if (input.scalar_type() == at::kFloat) {
-            LAUNCH_MOE_GATE_CONFIG(float32_t, 256, 16);
-          }
