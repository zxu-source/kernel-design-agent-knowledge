+        req_to_token = _make_req_to_token(pool_size * 2, max_len, self.device)
+
+        cache_seqlens = torch.empty(bs, dtype=torch.int32, device=self.device)
+        cu_seqlens_k = torch.empty(bs + 1, dtype=torch.int32, device=self.device)
