+    seq_len_delta: int,
+    page_size: int,
+    max_seq_pages: int,
+    width: int,
+) -> torch.Tensor:
+    """Per-row live region of the page table: the fused kernel self-guards on
+    seq_len and leaves columns past pages(seq_len + delta) untouched."""
+    live_pages = torch.clamp(
