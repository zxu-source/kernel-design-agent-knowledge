+            page_tokens = sorted(int(t) for t in v if t // self.PAGE_SIZE == p)
+            self.assertEqual(
+                page_tokens,
+                [p * self.PAGE_SIZE + i for i in range(self.PAGE_SIZE)],
+                "Page contents should be contiguous token ids",
+            )
