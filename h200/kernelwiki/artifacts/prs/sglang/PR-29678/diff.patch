+        if full_alloc.grow_direction == "up":
+            self.assertEqual(full_alloc.watermark_physical, watermark_before + 2)
+        else:
+            self.assertEqual(full_alloc.watermark_physical, watermark_before - 2)
+        # Free-list must have shrunk by 2.
+        self.assertEqual(
+            int(full_alloc.free_virtual_ids.numel()),
+            int(free_before.numel()) - 2,
+        )
