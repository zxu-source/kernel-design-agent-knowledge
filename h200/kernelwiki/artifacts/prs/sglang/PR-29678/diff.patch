+        # `_free_phys_pages` is a torch.Tensor; read the single
+        # hole position via `.tolist()` (`._alive` no longer exists).
+        hole_pos = int(fa._free_phys_pages.tolist()[0])
+        wm_before = fa.watermark_physical
