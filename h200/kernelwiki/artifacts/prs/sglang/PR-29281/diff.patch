+                exc_info=True,
+            )
+            _causal_conv3d_cat_pad_cuda_failed = True
+    if fused_causal_conv3d_cat_pad_triton is None:
+        raise RuntimeError("causal Conv3D cat/pad fusion is only available on CUDA")
