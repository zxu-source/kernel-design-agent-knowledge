-    torch.manual_seed(0)
-    # Values specifically chosen to stress the static_cast conversion path:
-    #   - exactly at ±448 (representable fp8 max)
-    #   - just inside the range
-    #   - just outside (must saturate)
-    #   - zero, small, and mid-range values
-    boundary_vals = [
-        0.0,
-        1.0,
-        -1.0,
-        100.0,
-        -100.0,
-        447.0,
-        -447.0,
-        448.0,
-        -448.0,
-        449.0,
-        -449.0,
-        1000.0,
-        -1000.0,
-    ]
