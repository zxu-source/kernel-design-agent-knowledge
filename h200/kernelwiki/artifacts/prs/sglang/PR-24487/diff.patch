-            kernel_size=patch_size,
-            stride=patch_size,
-            bias=bias,
-            dtype=dtype,
-        )
-        self.norm = nn.Identity()
-
-    def forward(self, x):
-        x = self.proj(x)
-        if self.flatten:
-            x = x.flatten(2).transpose(1, 2)
-        x = self.norm(x)
-        return x
