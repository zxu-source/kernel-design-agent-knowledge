+            atol=2e-3,
+            rtol=2e-3,
+        )
+        torch.testing.assert_close(
+            new_lse,
+            torch.full_like(new_lse, 0.6931472),  # log(2)
+            atol=1e-5,
+            rtol=1e-5,
+        )
+
+    def test_sink_dead_lse_stays_zero(self):
