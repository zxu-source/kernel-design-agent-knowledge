+        tri_out, _ = flash_mla_sparse_decode_triton(
+            q, k_cache, indices, topk_length, None, _D, _D**-0.5
+        )
+        torch.testing.assert_close(
+            tri_out.to(torch.float32),
+            ref_out.to(torch.float32),
+            atol=5e-2,
+            rtol=5e-2,
+        )
