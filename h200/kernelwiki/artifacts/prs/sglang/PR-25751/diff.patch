diff --git a/python/sglang/jit_kernel/csrc/sparse_mla_q8kv8_prefill_sm90/dense_fp8_transpose_v.h b/python/sglang/jit_kernel/csrc/sparse_mla_q8kv8_prefill_sm90/dense_fp8_transpose_v.h
