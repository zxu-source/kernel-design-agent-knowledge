+
+    JOIN_TP = 1
+    JOIN_NNODES = 2
+    JOIN_NODE_RANK = 1
+    TARGET_EP_SIZE = 6
+    CUDA_GRAPH_ARGS = DISABLED_CUDA_GRAPH_ARGS
+
+    def test_scale_up_on_demand(self):
