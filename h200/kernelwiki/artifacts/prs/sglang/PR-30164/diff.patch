+    JOIN_NODE_RANK = 1
+    TARGET_EP_SIZE = 6
+    CUDA_GRAPH_ARGS = DISABLED_CUDA_GRAPH_ARGS
+    MOE_DENSE_TP_SIZE = None
+
+
+@unittest.skipUnless(
