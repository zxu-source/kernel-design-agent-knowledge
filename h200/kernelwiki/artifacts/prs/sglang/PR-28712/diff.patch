+        o,
+        lse,
+        seq_lens,
+        head_dim,
+        block_size,
+        o.stride(0),
+        o.stride(1),
+        o.stride(2),
+        o.stride(3),
+        lse.stride(0),
+        lse.stride(1),
+        lse.stride(2),
+        NUM_KV_CHUNKS=NUM_KV_CHUNKS,
+    )
