+            GetActualSeqLenData(ACTUAL_SEQ_KV_INDEX, actualSeqLenKvData, actualSeqKVLen);
+            OPS_ERR_IF(actualSeqQLen != actualSeqKVLen,
+                       OPS_REPORT_VECTOR_INNER_ERR(contextKeyParams.opName, "VarLen scene, q is not equal kv."),
