+using UnInitHugeMemThreadLocal = void (*)(void *, bool);
+using ReleaseHugeMem = void (*)(void *, bool);
+using PTAGetExecCache = aclOpExecutor *(*)(uint64_t, uint64_t *);
+using InitPTACacheThreadLocal = void (*)();
