+    int32_t i_r;
+    int32_t i_c;
+    int32_t k;
+};
+
+template <typename TYPE, typename WORKSPACE_TYPE>
+struct PhyAddrCube1 {
+    __gm__ TYPE *left;
+    __gm__ TYPE *right;
+    __gm__ WORKSPACE_TYPE *out;
+    int32_t k = 0;
+};
+
+template <typename TYPE, typename WORKSPACE_TYPE>
