+                   padding_block_num * rowPerTime, 1, 1, 8, 8);
+    else
+        vector_dup(cur_buf_for_attn_score + tail_num * BASE_BLOCK_SIDE_LEN * rowPerTime, INPUT_T(0),
+                   padding_block_num * rowPerTime, 1, 1, 8, 8);
+
+    pipe_barrier(PIPE_V);
+}
