+#ifndef CATLASS_GEMM_KERNEL_MATMUL_FULL_LOADA_HPP
+#define CATLASS_GEMM_KERNEL_MATMUL_FULL_LOADA_HPP
+
+#include "catlass/catlass.hpp"
+#include "catlass/arch/resource.hpp"
