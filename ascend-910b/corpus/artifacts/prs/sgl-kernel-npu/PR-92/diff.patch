+
+    /// Logical coordinate
+    using TensorCoord = Coord<RANK, Index>;
+
+public:
+    // Methods
+
+    CATLASS_HOST_DEVICE
+    VectorLayout(Index size = 0) : shape_(MakeCoord(size)), stride_(MakeCoord(LongIndex(1))) {}
+
+    CATLASS_HOST_DEVICE
+    VectorLayout(Shape shape, Stride stride) : shape_(shape), stride_(stride) {}
