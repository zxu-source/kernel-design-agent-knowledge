+
+    /// Index type used for coordinates
+    using Index = uint32_t;
+
+    /// Long index type used for offsets
+    using LongIndex = int64_t;
+
+    /// Shape vector
+    using Shape = Coord<RANK, Index>;
+
+    /// Stride vector
