+};
+
+///////////////////////////////////////////////////////////
+
+/// Partial specialization for TPosition::VECIN
+template <class ArchTag>
+struct LocalTensorBuffer<ArchTag, AscendC::TPosition::VECIN> : LocalTensorBufferBase {
