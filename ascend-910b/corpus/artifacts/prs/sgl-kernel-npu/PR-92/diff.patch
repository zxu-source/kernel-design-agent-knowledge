+                                                 layout::PaddingColumnMajor>;
+    using LayoutPaddingTagB = std::conditional_t<std::is_same_v<LayoutTagB, layout::RowMajor>, layout::PaddingRowMajor,
+                                                 layout::PaddingColumnMajor>;
