+////////////////////
+// new add
+template <bool ENABLE_UNIT_FLAG_ = false, bool ENABLE_SHUFFLE_K_ = false, bool ENABLE_ABBA_ = false>
+struct GemmAtlasA2 : public MmadAtlasA2 {
