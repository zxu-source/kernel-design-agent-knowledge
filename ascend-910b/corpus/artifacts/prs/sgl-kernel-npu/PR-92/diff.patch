+
+///////////////////////////////////////////////////////////
+
+/// Partial specialization for TPosition::VECCALC
+template <class ArchTag>
+struct LocalTensorBuffer<ArchTag, AscendC::TPosition::VECCALC> : LocalTensorBufferBase {
