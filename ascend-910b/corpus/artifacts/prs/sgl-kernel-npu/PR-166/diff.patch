+template <TemplateMC2TypeA2layeredClass>
+__aicore__ inline uint32_t MoeDistributeDispatchV2Layered<TemplateMC2TypeA2layeredFunc>::GetExpRank(uint32_t expertId)
+{
+    return expertId / localMoeExpertNum_;
+}
