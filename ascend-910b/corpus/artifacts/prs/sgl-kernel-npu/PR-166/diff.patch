+
+    // tiling侧已确保数据上限，相乘不会越界，因此统一采用uint32_t进行处理
+    uint32_t axisBS_{0};
+    uint32_t globalBs_{0};
+    uint32_t axisH_{0};
+    uint32_t axisK_{0};   // 真实的K值
+    uint32_t alignK_{0};  // axisK_与 BITS32_PER_BLOCK 对齐
+    uint32_t aivNum_{0};
