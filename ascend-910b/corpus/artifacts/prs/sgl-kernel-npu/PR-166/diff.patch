+    // 0 <= qpIndex < qpNum
+    uint64_t rqPtr{0};
+
+    // HcclAiRMACQ��ά�����׵�ַ
+    // QP����: rankNum * qpNum
+    // ����ƫ�ƻ�ȡRCQָ��: rcqPtr + (dstRankId * qpNum + qpIndex) * sizeOfAiRMACQ
+    // 0 <= qpIndex < qpNum
+    uint64_t rcqPtr{0};
+
+    // HcclAivMemInfoһά����
+    // �ڴ���Ϣ����: rankNum
+    // ����ƫ�ƻ�ȡ�ڴ���Ϣָ��: memPtr + rankId * sizeOfAiRMAMem
+    // srcRankId ��ȡ�����ڴ���Ϣ��dstRankId ��ȡ Transport �ڴ���Ϣ
+    uint64_t memPtr{0};
+    // ������׷���ֶ�
+};
