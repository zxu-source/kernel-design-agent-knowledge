+    def _io_parachk(self: any, types: list, type_name: str) -> list:
+        chk = []
+        for iot in types:
+            if iot == "optional":
+                ptype = "OPTION"
+            else:
+                ptype = iot.upper()
+            chk.append("para_check.{}_{}".format(ptype, type_name))
+        return chk
