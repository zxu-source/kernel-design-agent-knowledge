-
-        // *** lp = castfp32to16(ls)
-        if (std::is_same<ElementOutput, bfloat16_t>::value) {
-            AscendC::Cast<ElementOutput, float, false>(
-                lpUbTensor[sUbOffset * 2], lsUbTensor[sUbOffset], AscendC::RoundMode::CAST_RINT, (uint64_t)0,
