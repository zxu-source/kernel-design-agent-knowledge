-                    // Locate the current tile of matrix A on L1
-                    auto tensorTileL1A = GetTile(tensorL1A, tla::MakeCoord(mPartIdx * L0_TILE_M, kPartIdx * L0_TILE_K),
-                                                 tla::MakeShape(mPartActual, kPartActual));
