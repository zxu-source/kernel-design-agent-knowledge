-        uint32_t kBlockActual = actualShape.k();
-        uint32_t nBlockActual = actualShape.n();
-        uint32_t mNextBlockActual = actualShapeNext.m();
-        uint32_t kNextBlockActual = actualShapeNext.k();
-        uint32_t nNextBlockActual = actualShapeNext.n();
