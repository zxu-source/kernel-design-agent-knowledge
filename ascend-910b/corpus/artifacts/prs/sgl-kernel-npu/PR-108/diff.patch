-        uint32_t kActual = (firstTileIdx < kTileCount - 1) ? L1_TILE_K : (kBlockActual - firstTileIdx * L1_TILE_K);
-        uint32_t kTileCountNext = CeilDiv<L1_TILE_K>(kNextBlockActual);
-        uint32_t firstTileIdxNext = startTileIdx % kTileCountNext;
