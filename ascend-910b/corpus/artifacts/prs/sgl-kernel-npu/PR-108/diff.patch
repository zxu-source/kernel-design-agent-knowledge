-                    copyUb2Gm(tensorTileDst, tensorSrcUb);
-                }
-                AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(eventIds[bufferIndex]);
-
-                bufferIndex = (bufferIndex + 1) % BUFFER_NUM;
-            }
-        }
