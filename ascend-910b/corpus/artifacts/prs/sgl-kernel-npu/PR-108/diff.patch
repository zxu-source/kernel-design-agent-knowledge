-    /// Perform a block-scoped matrix multiply-accumulate
-    template <class TensorA, class TensorB, class TensorC>
-    CATLASS_DEVICE void operator()(TensorA &tensorA, TensorB &tensorB, TensorC &tensorC, TensorA &tensorNextA,
