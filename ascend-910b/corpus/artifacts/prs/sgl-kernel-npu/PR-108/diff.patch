-        uint32_t pingpong = 0;
-        for (uint32_t loopIdx = 0; loopIdx < loops; ++loopIdx) {
-            uint32_t actualTiles = TILES_PER_LOOP;
-            if (loopIdx == loops - 1) {
-                actualTiles = tilesPerAiv - loopIdx * TILES_PER_LOOP;
-            }
