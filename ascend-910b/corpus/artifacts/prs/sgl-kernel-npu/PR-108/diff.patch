-protected:
-    /// Data members
-    AscendC::LocalTensor<ElementIn> ubInTensorList[STAGES];
-    AscendC::LocalTensor<ElementOut> ubOutTensorList[STAGES];
-
-    int32_t ubEventList[STAGES];
-};
