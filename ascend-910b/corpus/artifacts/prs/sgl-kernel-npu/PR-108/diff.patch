-
-        CATLASS_HOST_DEVICE
-        Params(GemmCoord const &problemShape_, bool aNeedPadding_, bool bNeedPadding_, GM_ADDR ptrA_, LayoutA layoutA_,
-               GM_ADDR ptrB_, LayoutB layoutB_, GM_ADDR ptrC_, LayoutC layoutC_, GM_ADDR ptrWA_, LayoutA layoutWA_,
