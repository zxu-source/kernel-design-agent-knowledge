-        bool bNeedPadding;
-        GM_ADDR ptrA;
-        LayoutA layoutA;
-        GM_ADDR ptrB;
-        LayoutB layoutB;
-        GM_ADDR ptrC;
-        LayoutC layoutC;
-        GM_ADDR ptrWA;
-        LayoutA layoutWA;
-        GM_ADDR ptrWB;
-        LayoutB layoutWB;
